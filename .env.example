# PostgreSQL connection string
# Example (Docker): postgresql://postgres:postgres@db:5432/email_templates?schema=public
# Example (local):  postgresql://postgres:postgres@localhost:5432/email_templates?schema=public
DATABASE_URL=

# NextAuth / Auth.js secret – generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys)
# This project uses the existing RESEND_API variable in Vercel.
RESEND_API=
# Sandbox sender: delivery is limited to the Resend account email.
# For arbitrary recipients, verify your domain and replace this value.
RESEND_FROM_EMAIL=Crypto Notifications <onboarding@resend.dev>

# Optional: public app URL for OAuth callbacks
# NEXTAUTH_URL=http://localhost:3000
