# PostgreSQL connection string
# Example (Docker): postgresql://postgres:postgres@db:5432/email_templates?schema=public
# Example (local):  postgresql://postgres:postgres@localhost:5432/email_templates?schema=public
DATABASE_URL=

# NextAuth / Auth.js secret – generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sandbox sender: only delivers to the email address used to create the Resend account.
# Verify a custom domain in Resend before sending to arbitrary recipients.
# The send route uses onboarding@resend.dev.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: public app URL for OAuth callbacks
# NEXTAUTH_URL=http://localhost:3000
