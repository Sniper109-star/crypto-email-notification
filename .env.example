# PostgreSQL connection string
# Example (Docker): postgresql://postgres:postgres@db:5432/email_templates?schema=public
# Example (local):  postgresql://postgres:postgres@localhost:5432/email_templates?schema=public
DATABASE_URL=

# NextAuth / Auth.js secret – generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys)
# This project uses the existing RESEND_API variable in Vercel.
RESEND_API=
# Use a real verified sender address. Do not quote a JavaScript expression here.
# Example: binance <noreply@deloittechstore.site>
RESEND_FROM_EMAIL=binance <noreply@deloittechstore.site>
# Optional fallback sender when RESEND_FROM_EMAIL is not set.
RESEND_FROM_EMAIL_5=binance <noreply@deloittechstore.site>

# Optional: public app URL for OAuth callbacks
# NEXTAUTH_URL=http://localhost:3000

# QStash is not required; email delivery is sent directly through Resend.
